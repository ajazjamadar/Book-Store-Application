# Copy this file to .env and fill in real values before running docker compose.
#
#   cp .env.example .env
#
# .env is git-ignored — never commit real secrets.

# ── Database ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=Root@1234

# ── SendGrid ────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key-here
EMAIL_FROM=no-reply@bookstore.com
EMAIL_TO=rrm36.orders@inbox.testmail.app

# ── TestMail ────────────────────────────────────────────────────────────────────
TESTMAIL_API_KEY=your-testmail-api-key-here
TESTMAIL_NAMESPACE=rrm36
